# WatchStudio — non-secret placeholders for the Base44 sandbox stack.
#
# Listed FIRST in docker-compose.base44.yml, so /run/base44/app.env (platform
# secrets, e.g. a dashboard-provided NEXTAUTH_SECRET) always overrides these.
# Do not add real credentials here.

# Development-only Auth.js signing secret, at least 32 characters.
# Replace with `openssl rand -base64 32` for any non-local use.
NEXTAUTH_SECRET=base44-dev-only-insecure-authjs-secret-change-me
