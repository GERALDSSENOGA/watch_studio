# WatchStudio — local development environment variables
# Copy this file to .env and fill in the values. Never commit real secrets.

# PostgreSQL connection string. Local dev example (start your own database,
# e.g. with docker-compose.yml in this repo):
DATABASE_URL="postgresql://watchstudio:watchstudio@localhost:5434/watchstudio?sslmode=disable"

# NextAuth / Auth.js v5 secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"

# WebSocket server (separate process from Next.js)
WS_PORT="3001"
WS_ORIGIN="http://localhost:3000"
# Browser-facing WebSocket URL
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Optional: YouTube Data API key for deeper embeddability checks.
# Not required for local development; embeddability is determined client-side.
# YOUTUBE_API_KEY=""
