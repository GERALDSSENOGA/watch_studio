# WatchStudio — production environment variables
#
# Copy this file to .env.production and fill in every value before deploying.
# Never commit real secrets to version control.

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
# Connection string used by Prisma and the Next.js app.
# Example (managed Postgres):
# DATABASE_URL="postgresql://watchstudio:<password>@db-host:5432/watchstudio?sslmode=require"
DATABASE_URL="postgresql://watchstudio:CHANGE_ME@db:5432/watchstudio?sslmode=disable"

# Password for the postgres superuser (used by docker-compose db service).
DB_PASSWORD="CHANGE_ME"

# ---------------------------------------------------------------
# NextAuth / Auth.js v5
# ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS"

# Must match your public HTTPS domain exactly (no trailing slash).
# Cookies and OAuth callbacks are scoped to this origin.
NEXTAUTH_URL="https://your-domain.com"

# ---------------------------------------------------------------
# WebSocket server (separate process from Next.js)
# ---------------------------------------------------------------
WS_PORT="3001"
# Origin the WS server accepts connections from (CORS/handshake check).
WS_ORIGIN="https://your-domain.com"

# Browser-facing WebSocket URL. Browsers require wss:// in production.
NEXT_PUBLIC_WS_URL="wss://your-domain.com:3001"

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# YouTube Data API key (not wired; embeddability is detected client-side).
# YOUTUBE_API_KEY=""
